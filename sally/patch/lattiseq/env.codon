from numpy.create import array

import sequre.lattiseq.ckks as ckks
import sequre.lattiseq.rlwe as rlwe
import sequre.lattiseq.params as lattiseq_params

from sequre.constants import LATTISEQ_STANDARD_RING_ENUM


class CKKSEnv:
    """
    Environment for CKKS homomorphic encryption operations.
    """
    
    _sk: rlwe.SecretKey

    params: ckks.Parameters
    pk: rlwe.PublicKey
    rlk: rlwe.RelinearizationKey
    rtks: rlwe.RotationKeySet

    encoder: ckks.EncoderComplex128
    encryptor: ckks.PkEncryptor
    decryptor: ckks.Decryptor
    evaluator: ckks.Evaluator

    _bootstrap_min_level: int
    _debug: bool

    def __init__(
            self,
            params_literal=lattiseq_params.PN14QP438,
            debug=False):
        self.params = ckks.new_parameters_from_literal(params_literal)
        kgen = ckks.new_key_generator(self.params)
        
        self._sk = kgen.gen_secret_key(store_key=True)
        self.pk = kgen.gen_public_key()
        self.rlk = kgen.gen_relinearization_key(self._sk, 1)
        rotation_shifts = [1 << i for i in range(self.params.log_slots)]
        rotation_shifts.extend([(self.params.slots() - s) for s in rotation_shifts])
        self.rtks = kgen.gen_rotation_keys_for_rotations(
            rotation_shifts,
            self.params.ring_type == LATTISEQ_STANDARD_RING_ENUM, self._sk)

        self.encoder = ckks.new_encoder_complex(self.params)
        self.encryptor = ckks.new_encryptor(self.params, self.pk)
        self.decryptor = ckks.new_decryptor(self.params, self._sk)
        self.evaluator = ckks.new_evaluator(
            self.params, rlwe.EvaluationKey(rlk=self.rlk, rtks=self.rtks))

        # Minimum level to trigger bootstrapping, can be tuned based on params
        self._bootstrap_min_level = 0
        self._debug = debug
    
    def publish(self) -> CKKSEnv:
        return CKKSEnv(
            params=self.params,
            pk=self.pk,
            rlk=self.rlk,
            rtks=self.rtks,
            encoder=self.encoder,
            encryptor=self.encryptor,
            evaluator=self.evaluator)
    
    def is_published(self) -> bool:
        return bool(self._sk) == False and bool(self.decryptor) == False
    
    def is_debug(self) -> bool:
        return self._debug
    
    def zeros_ciphertext(self) -> ckks.Ciphertext:
        ct = ckks.new_ciphertext(
            params=self.params,
            degree=1,
            level=self.params.max_level(),
            scale=self.params.default_scale)
        self.encryptor._mm_encrypt_zero(ct.get_rlwe_ciphertext())
        
        return ct
    
    def encode(self, values) -> ckks.Plaintext:
        max_vals = self.params.slots()
        length = len(values)
        assert length <= max_vals, f"Too many values: {length} > {max_vals}."

        # Encoding values
        plaintext = ckks.new_plaintext(
            self.params,
            self.params.max_level(),
            self.params.default_scale)

        self.encoder.encode(
            values.tolist().to_complex(),
            plaintext,
            self.params.log_slots)

        return plaintext

    def encrypt(self, values) -> ckks.Ciphertext:
        plaintext = self.encode(values)
        return self.encryptor.encrypt_new(plaintext)
    
    def decrypt[dtype=float](self, ct: ckks.Ciphertext):
        decoded = self.encoder.decode(
            self.decryptor.decrypt_new(ct), self.params.log_slots)
        
        if isinstance(dtype, int):
            return array([int(round(float(c))) for c in decoded])
        
        # dtype is float or complex
        return array([dtype(c) for c in decoded])
    
    def bootstrap(self, ct: ckks.Ciphertext) -> None:
        # Temporary bootstrapper
        ct.value = self.encrypt(self.decrypt(ct, dtype=int)).value
    
    def refresh(self, ct: ckks.Ciphertext) -> None:
        if ct.scale > self.params.default_scale:
            self.evaluator.rescale(ct, self.params.default_scale, ct)
        
        if ct.requires_bootstrap(self._bootstrap_min_level):
            self.bootstrap(ct)
    
    def iadd(self, ct: ckks.Ciphertext, other) -> ckks.Ciphertext:
        other_enc = self._check_encodable(other)
        self.evaluator.add(ct, other_enc, ct)
        return ct
    
    def imul(self, ct: ckks.Ciphertext, other) -> ckks.Ciphertext:
        other_enc = self._check_encodable(other)

        self.refresh(ct)
        if isinstance(other, ckks.Ciphertext):
            self.refresh(other_enc)

        self.evaluator.mul_relin(ct, other_enc, True, ct)        
        return ct
    
    def irotate_butterfly(
            self, ct: ckks.Ciphertext, k: int) -> ckks.Ciphertext:
        slots = self.params.slots()
        neg = False
        
        if k < 0:
            neg = True
            k = -k
        
        if k > slots:
            k %= slots
        if k > (slots >> 1):
            k = slots - k
            neg ^= True
        
        log_step = 0
        while k:
            tzs = k.__cttz__()
            k >>= (tzs + 1)
            log_step += tzs
            step = 1 << log_step
            log_step += 1
        
            self.evaluator.rotate(ct, (slots - step) if neg else step, ct)
        
        return ct
    
    def irotate(self, ct: ckks.Ciphertext, steps: int) -> ckks.Ciphertext:
        return self.irotate_butterfly(ct, steps)
    
    def add(self, ct: ckks.Ciphertext, other) -> ckks.Ciphertext:
        return self.iadd(ct.copy(), other)
    
    def mul(self, ct: ckks.Ciphertext, other) -> ckks.Ciphertext:
        return self.imul(ct.copy(), other)
    
    def rotate(self, ct: ckks.Ciphertext, steps: int) -> ckks.Ciphertext:
        return self.irotate(ct.copy(), steps)
    
    def _check_encodable(self, value):
        if isinstance(value, ckks.Ciphertext) or isinstance(value, ckks.Plaintext):
            return value

        return self.encode(value)
    