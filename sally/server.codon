"""
Server-side logic for secure star-allele calling using fully homomorphic encryption:
    - Filter alleles and mutations based on coverage and CN solution.
    - Build ILP mats for allele calling.
    - Solve ILP using custom solvers (e.g., hill climbing).
    - Validate solution and extract selected alleles and novel mutations.
"""

from modelling.ilp import build_major_mats


def filter_alleles(
    alleles, filtered_cov: Ciphertensor, cn_bloom: BloomFilter
) -> Ciphertensor:
    """
    Filter alleles that are not expressed.

    :returns: Expressed alleles.
    """
    mask = Ciphertensor[Ciphertext].zeros((len(alleles),))
    for an, a in natsorted(alleles.items()):
        mask += cn_bloom.contains(a.cn_config).rotate(an)
    
    cov_mask = alleles @ filtered_cov
    mask *= cov_mask

    return filter_by_mask(alleles, mask > 0, max_size=ALLELE_DB_MAX_SIZE)


def call_alleles(gene, filtered_cov, cn_solution, func_muts, solver_type):
    # Filter alleles and get functional mutations
    print(f"\nFiltering alleles and mutations...")
    alleles = filter_alleles(gene, filtered_cov, cn_solution)
    print(f"  Candidate alleles: {len(alleles)}")
    
    if not alleles:
        print("\n✗ No candidate alleles found!")
        return
    
    # Extract mats
    print(f"\n{'='*70}")
    print(f"EXTRACTING ILP mats")
    print(f"{'='*70}")
    mats = build_major_mats(
        gene, filtered_cov, cn_solution, alleles, func_muts)
    
    print(f"\nMatrix dimensions:")
    print(f"  A: {mats.A.shape[0]} × {mats.A.shape[1]} (muts × alls)")
    print(f"  B: {mats.B.shape[0]} × {mats.B.shape[1]} (CN confs × alls)")
    print(f"  c: {len(mats.c)} (coverage observations)")
    print(f"  d: {len(mats.d)} (CN requirements)")
    
    # Solve with selected solver
    if solver_type == 'hc':
        obj_val, x_val, y_val, e_val, z_val = hill_climbing(mats)
    elif solver_type == 'exhaustive':
        obj_val, x_val, y_val, e_val, z_val = exhaustive_search(mats)
    else:
        raise ValueError(f"Unknown solver type: {solver_type}.")

    return mats, obj_val, x_val, y_val, e_val, z_val


def _debug_validate_solution(
    mats: MajorILPmats,
    x: np.ndarray,
    y: np.ndarray,
    e: np.ndarray,
    z: float,
) -> Dict[str, Any]:
    """
    Validate that a solution satisfies all constraints and compute objective.
    
    :param mats: The ILP mats
    :param x: Allele selection vector
    :param y: Novel mutation vector
    :param e: Error vector
    :param z: Novel indicator
    :return: Dict with validation results and constraint violations
    """
    violations = []
    
    # Check coverage equality: A·x + y + e = c
    coverage_lhs = mats.A @ x + y + e
    coverage_diff = np.abs(coverage_lhs - mats.c)
    if len(coverage_diff) > 0 and np.max(coverage_diff) > 1e-6:
        violations.append(f"Coverage equality violated: max diff = {np.max(coverage_diff)}")
    
    # Check CN configuration: B·x = d
    cn_lhs = mats.B @ x
    cn_diff = np.abs(cn_lhs - mats.d)
    if len(cn_diff) > 0 and np.max(cn_diff) > 1e-6:
        violations.append(f"CN configuration violated: max diff = {np.max(cn_diff)}")
    
    # Check ordering: x[j1] <= x[j2] for all (j1, j2) in P_indices
    for j1, j2 in mats.P_indices:
        if x[j1] > x[j2] + 1e-6:
            violations.append(f"Ordering violated: x[{j1}] = {x[j1]} > x[{j2}] = {x[j2]}")
    
    # Check novel indicator: z >= y[i] for all i
    for i in range(mats.n_mutations):
        if z < y[i] - 1e-6:
            violations.append(f"Novel indicator violated: z = {z} < y[{i}] = {y[i]}")
    
    # Check one novel per position
    for pos, indices in mats.position_groups.items():
        total = sum(y[i] for i in indices)
        if total > 1 + 1e-6:
            violations.append(f"One-novel-per-position violated at pos {pos}: sum = {total}")
    
    # Compute objective
    objective = np.sum(np.abs(e)) + mats.lambda_novel * z + 0.1 * np.sum(y)
    
    return {
        "valid": len(violations) == 0,
        "violations": violations,
        "objective": objective,
        "coverage_fit": np.sum(np.abs(e)),
        "novel_penalty": mats.lambda_novel * z,
        "mutation_penalty": 0.1 * np.sum(y),
    }


def _debug_validate(mats, x_val, y_val, e_val, z_val):
    # Validate solution
    print(f"\n{'='*70}")
    print(f"VALIDATING SOLUTION")
    print(f"{'='*70}")
    validation = _debug_validate_solution(mats, x_val, y_val, e_val, z_val)
    
    if validation["valid"]:
        print(f"✓ Solution is VALID - all constraints satisfied")
    else:
        print(f"✗ Solution has VIOLATIONS:")
        for v in validation["violations"]:
            print(f"    - {v}")